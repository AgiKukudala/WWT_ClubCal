# ClubCal configuration. Copy to .env for local (non-Docker) development:  cp .env.example .env
# No value here is a real secret. Generate your own for any shared deployment.

NODE_ENV=development
PORT=3000

# PostgreSQL connection. Docker Compose builds this from POSTGRES_PASSWORD automatically.
DATABASE_URL=postgres://clubcal:change-me-local-only@localhost:5432/clubcal
# Used by `docker compose` for the database container (local-only password; change it).
POSTGRES_PASSWORD=change-me-local-only

# Required in production. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string
SESSION_TTL_HOURS=168
# auto = Secure cookies only when NODE_ENV=production (requires HTTPS)
COOKIE_SECURE=auto
# Origins allowed to make state-changing requests (comma separated)
APP_ORIGIN=http://localhost:3000,http://localhost:5173
PUBLIC_URL=http://localhost:3000
# Set to true only when running behind a trusted reverse proxy
TRUST_PROXY=false

# Email. Leave SMTP_HOST empty to disable email entirely (in-app notifications still work).
# The Docker setup points this at Mailpit, which CAPTURES mail locally; nothing reaches real inboxes.
# For real delivery, use your school's SMTP relay host, port, user and password here.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ClubCal <no-reply@clubcal.local>

# Worker: how often due reminders are dispatched
REMINDER_POLL_SECONDS=15
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
LOG_LEVEL=info
